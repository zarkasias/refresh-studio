{
  "permissions": {
    "allow": [
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm test)",
      "Bash(pnpm test:*)",
      "Bash(pnpm eval:*)",
      "Bash(pnpm gate:m0)",
      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm --filter * typecheck)",
      "Bash(pnpm --filter * test:*)",
      "Bash(pnpm --filter @srs/site-model db:generate:*)",
      "Bash(pnpm exec drizzle-kit generate:*)",
      "Bash(git status)",
      "Bash(git diff:*)"
    ],
    "ask": [
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_tabs"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.development.local)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm -s typecheck >/dev/null 2>&1 || { echo 'Typecheck failed after this edit. Run pnpm typecheck and fix before continuing.' >&2; exit 2; }"
          }
        ]
      }
    ]
  }
}